{
  "manifest_version": 3,
  "name": "lihe_tools",
  "version": "1.1",
  "version_name": "dev version",
  "description": "浏览器工具",
  "short_name": "Short Name",
  "permissions": [
    "activeTab",
    "tabs",
    "cookies",
    "webRequest",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "update_url": "http://path/to/updateInfo.xml"
}